#!/bin/sh
# Environment for the release scripts (sourced by bin/jantar).

# jantar talks to no other nodes: no distribution, so no epmd and no
# cookie needed. The Nix package removes the build-time cookie; this
# placeholder keeps the start script happy.
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-none}"
export RELEASE_COOKIE="${RELEASE_COOKIE:-jantar-has-no-distribution}"
